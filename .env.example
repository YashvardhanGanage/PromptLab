# ==============================================================================
# PromptLab Root Environment Template
# Copy this file to .env for local configuration.
# Never commit actual secrets or production credentials to Git.
# ==============================================================================

# --- Backend Configuration ---
# File path for SQLite database persistence
DATABASE_PATH=./promptlab.db

# Ollama local endpoint URL
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Default model name available in local Ollama (e.g., llama3.2:1b)
DEFAULT_MODEL=llama3.2:1b

# When true, uses zero-latency deterministic mock LLM for offline tests
# Set to false to use live local Ollama inference
MOCK_LLM=false

# Authorized frontend origins for CORS (comma-separated, without trailing slashes)
# In production, replace with your deployed Vercel frontend domain (e.g. https://promptlab.vercel.app)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Frontend Configuration (Vite) ---
# Base API URL used by the browser client to communicate with the FastAPI backend
# In local development: http://127.0.0.1:8000
# In production: https://your-backend-service.onrender.com
VITE_API_URL=http://127.0.0.1:8000
